# Mini Ordering System - Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_HOST=localhost
DB_NAME=mini_qr_ordering_db
DB_USER=root
DB_PASS=

# Application Settings
APP_DEBUG=false
APP_ENV=development

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Security
ENABLE_CSRF_PROTECTION=true
CSRF_TOKEN_LIFETIME=3600
SESSION_TIMEOUT=1800

# Feature Flags
ENABLE_STOCK_MANAGEMENT=true
ENABLE_PAYMENT_SIMULATION=true
ENABLE_QR_GENERATION=true

# API Configuration
API_TIMEOUT=30
API_RATE_LIMIT=100

# Email Configuration (for future use)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@gourmetexpress.com

# Payment Gateway (for future use)
PAYMENT_GATEWAY=stripe
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=

# Third-party Services
GOOGLE_ANALYTICS_ID=
SENTRY_DSN=
